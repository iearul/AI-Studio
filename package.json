{
  "name": "ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, human-in-the-loop AI filmmaking studio",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "app:install": "bash scripts/local-app.sh install",
    "app:logs": "bash scripts/local-app.sh logs",
    "app:start": "bash scripts/local-app.sh start",
    "app:status": "bash scripts/local-app.sh status",
    "app:stop": "bash scripts/local-app.sh stop",
    "app:uninstall": "bash scripts/local-app.sh uninstall",
    "app:update": "bash scripts/local-app.sh update",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @ai-studio/contracts --filter @ai-studio/book-engine --filter @ai-studio/database --filter @ai-studio/storage --filter @ai-studio/film-engine --filter @ai-studio/providers --filter @ai-studio/book-export build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @ai-studio/database migrate",
    "dev": "pnpm build:packages && pnpm --parallel --filter @ai-studio/api --filter @ai-studio/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @ai-studio/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @ai-studio/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}

# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100/api/v1

# Storage paths are resolved from the repository root when relative.
DATABASE_PATH=data/film-studio.sqlite
PROJECTS_PATH=data/projects
BACKUPS_PATH=data/backups
CACHE_PATH=cache

# Provider credentials (leave blank until the provider is enabled)
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.4-mini
OPENAI_STORY_TIMEOUT_MS=180000
KLING_API_KEY=
SEEDANCE_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local AI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_WORKFLOW_PATH=config/comfyui/image-workflow.json
COMFYUI_IMAGE_MODEL=z_image_turbo_int8_convrot.safetensors
COMFYUI_IMAGE_TIMEOUT_MS=1200000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_STORY_MODEL=qwen3.5:9b-mlx
OLLAMA_STORY_TIMEOUT_MS=600000

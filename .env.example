# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100/api/v1

# Storage paths are resolved from the repository root when relative.
DATABASE_PATH=data/film-studio.sqlite
PROJECTS_PATH=data/projects
BACKUPS_PATH=data/backups
CACHE_PATH=cache
SECRETS_PATH=data/secrets

# Provider credentials (leave blank until the provider is enabled)
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.4-mini
OPENAI_STORY_TIMEOUT_MS=180000
KLING_API_KEY=
KLING_VIDEO_MODEL=kling-3.0
KLING_VIDEO_TIMEOUT_MS=30000
# Optional safety estimate shown before Kling submission. Check your account price.
KLING_ESTIMATED_USD_PER_SECOND=
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_VIDEO_TIMEOUT_MS=30000
# Official enhanced Seedance 2.0 720p rate at implementation time.
SEEDANCE_ESTIMATED_USD_PER_SECOND=0.303
ELEVENLABS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URI to the Google OAuth web client as an authorized redirect URI.
GOOGLE_REDIRECT_URI=http://127.0.0.1:4100/api/v1/integrations/google-drive/callback
# Optional headless recovery path. Normal setup stores the token after OAuth consent.
GOOGLE_REFRESH_TOKEN=

# Local text AI (story generation only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_STORY_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_STORY_TIMEOUT_MS=600000

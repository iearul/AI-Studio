{
  "28": {
    "inputs": {
      "unet_name": "{{MODEL}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Z-Image diffusion model"
    }
  },
  "30": {
    "inputs": {
      "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen text encoder"
    }
  },
  "29": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load Z-Image VAE"
    }
  },
  "27": {
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": ["30", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Encode storyboard prompt"
    }
  },
  "33": {
    "inputs": {
      "conditioning": ["27", 0]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Z-Image negative conditioning"
    }
  },
  "13": {
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Storyboard frame dimensions"
    }
  },
  "11": {
    "inputs": {
      "shift": 3,
      "model": ["28", 0]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "Z-Image sampling"
    }
  },
  "3": {
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 8,
      "cfg": 1,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["11", 0],
      "positive": ["27", 0],
      "negative": ["33", 0],
      "latent_image": ["13", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Generate storyboard latent"
    }
  },
  "8": {
    "inputs": {
      "samples": ["3", 0],
      "vae": ["29", 0]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode storyboard frame"
    }
  },
  "9": {
    "inputs": {
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "images": ["8", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save storyboard frame"
    }
  }
}
